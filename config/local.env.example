# Copy to var/local.env (ignored). Development defaults are localhost-only.
KITCHER_DEBUG=1
KITCHER_ALLOWED_HOSTS=localhost,127.0.0.1
KITCHER_HTTPS=0
# For phone access through Caddy, set DEBUG=0, HTTPS=1, and actual LAN values:
# KITCHER_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
# KITCHER_CSRF_ORIGINS=https://192.168.1.100
# An independent random secret is generated in var/django-secret unless set here.
# KITCHER_SECRET_KEY=
# Daily verified full-database backups; mirror to a different physical disk.
# KITCHER_BACKUP_DIR=D:\kitcher\backups
# KITCHER_BACKUP_MIRROR=C:\Users\mwang\KitcherBackups
